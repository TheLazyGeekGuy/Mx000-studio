 "transcription": {
  "method": "Visual reading of 130 dpi renderings (pdftoppm) of PDF pages 4-11; message-type table re-read at 250 dpi. pdftotext output is glyph-substituted (embedded Type 1C fonts with custom encoding) and is NOT used as the reading.",
  "crosscheck": "research/crosscheck_sysex_tables.py decodes the digit glyphs of the pdftotext -layout output and compares every numeric row (ID, Ctrl, Min, Max) with this file: 308 rows (34 system + 274 engine), 0 mismatches on 2026-10-20.",
  "read_at": "2026-10-20T09:50/09:59+02:00 (rendered-page reading), cross-check run 10:00+02:00",
  "reader": "Claude sub-agent (model claude-opus-5-5, effort not exposed)"
 },
 "conventions": {
  "id": "Base parameter identifier used by SYXTYPE_PARAMREQUEST (0x47) / SYXTYPE_PARAMDATA (0x22), p.3",
  "cc": "'Ctrl.' column: hard-wired controller number; null where the spec prints N/A. In this edition every printed Ctrl equals ID+10.",
  "min_max": "Absolute values carried by Parameter Data as signed 14-bit (MSB first, p.3). Units and display scaling are NOT given by the spec.",
  "cc_scaling": "A controller value 0-127 is scaled to the valid parameter range (p.4); exact rounding not documented.",
  "engine_type_field": "Parameter messages: 0 = Engine 1, 1 = Engine 2, 2 = system (p.1, p.3).",
  "missing_ids": "Gaps in ID columns (e.g. ID 0 absent for Compressor/Limiter/Gate/Deesser/EQ, ID 16 and 32 absent in VSS tables, IDs 28-33 absent in the system table) are printed gaps, not omissions of this transcription. Requests spanning undefined IDs return values that 'should be ignored' (p.3)."
 },
